APP_NAME=auditRAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_USER=auditrag
POSTGRES_PASSWORD=auditrag
POSTGRES_DB=auditrag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

QDRANT_HOST=qdrant
QDRANT_PORT=6333
# For Qdrant Cloud: set URL (from cluster dashboard) and API key
# QDRANT_URL_OVERRIDE=https://your-cluster-id.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

OPENAI_API_KEY=your-key-here
EMBEDDING_PROVIDER=local

ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GENERATION_PROVIDER=openai

# Retrieval: dense | sparse | hybrid (default: hybrid)
RETRIEVAL_MODE=hybrid
# Optional Cohere rerank (set COHERE_API_KEY to enable)
USE_RERANKER=false
COHERE_API_KEY=
